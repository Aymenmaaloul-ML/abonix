# Copiez ce fichier en .env (local) ou renseignez ces variables chez votre hébergeur. Ne committez jamais .env.

# --- Base de données PostgreSQL (obligatoire) ---
# Local :  postgresql://abonix:motdepasse@localhost:5432/abonix
# Neon :   postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/abonix?sslmode=require
DATABASE_URL="postgresql://abonix:abonix_dev@localhost:5432/abonix"

# --- Site ---
# Adresse publique du site (https en production : active le cookie sécurisé __Host-).
APP_URL="http://localhost:3000"

# Numéro WhatsApp par défaut (chiffres uniquement, indicatif inclus, sans « + »).
# Modifiable ensuite dans Admin → Réglages.
WHATSAPP_NUMBER="21655056614"

# Sel pour l'empreinte des adresses IP (anti-abus). Obligatoire en production, 24 caractères minimum.
# Générer : openssl rand -base64 32
HASH_SALT=""

# --- Images ---
# "local" : fichiers sur disque (VPS/Docker avec volume persistant).
# "cloudinary" : recommandé sur Vercel (disque éphémère).
STORAGE_PROVIDER="local"
UPLOAD_DIR="./storage/uploads"

# Requis uniquement si STORAGE_PROVIDER="cloudinary"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="abonix"

# --- Docker Compose uniquement ---
POSTGRES_PASSWORD=""
